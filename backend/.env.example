PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/evidence_system
JWT_SECRET=EvidenceSystem_JWT_Secret_Change_In_Production
JWT_EXPIRES_IN=7d
MFA_JWT_SECRET=EvidenceSystem_MFA_Secret_Change_In_Production
MFA_TOKEN_EXPIRES_IN=5m
STORAGE_UPLOADS_DIR=storage/uploads
STORAGE_REPORTS_DIR=storage/reports
NODE_ENV=development
DEV_AUTH_FALLBACK=false
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:4173
JSON_BODY_LIMIT=2mb
URLENCODED_BODY_LIMIT=2mb
MAX_FILE_SIZE_MB=25

LOGIN_OTP_ENABLED=true
LOGIN_OTP_EXPIRES_MINUTES=5
OTP_DELIVERY=console
OTP_SHOW_DEV_CODE=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Digital Evidence System <no-reply@evidence.local>"
