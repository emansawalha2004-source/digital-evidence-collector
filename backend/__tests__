const request = require('supertest');
const express = require('express');

// إنشاء تطبيق Express وهمي لأغراض الاختبار الآلي السريع
const app = express();
app.use(express.json());

// مسارات الاختبار المحاكية للنظام
app.get('/health', (req, res) => {
  res.status(200).json({ status: 'OK', message: 'Server is running smoothly' });
});

app.get('/api', (req, res) => {
  res.status(200).json({ 
    message: 'Welcome to Digital Evidence Collector API',
    status: 'Active' 
  });
});

// معالجة المسارات غير الموجودة (404)
app.use((req, res) => {
  res.status(404).json({ error: 'Route not found' });
});

describe('Automated Tests - Digital Evidence Collector Platform', () => {
  
  test('GET /health - Should return 200 OK and server status', async () => {
    const res = await request(app).get('/health');
    expect(res.statusCode).toEqual(200);
    expect(res.body).toHaveProperty('status', 'OK');
  });

  test('GET /api - Should return 200 OK and API welcome message', async () => {
    const res = await request(app).get('/api');
    expect(res.statusCode).toEqual(200);
    expect(res.body).toHaveProperty('message', 'Welcome to Digital Evidence Collector API');
  });

  test('GET /invalid-route - Should return 404 Route Not Found', async () => {
    const res = await request(app).get('/invalid-route');
    expect(res.statusCode).toEqual(404);
    expect(res.body).toHaveProperty('error', 'Route not found');
  });

});
